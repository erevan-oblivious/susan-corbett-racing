---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppFloat.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  transparentHeader?: boolean; /* Allows for optional transparent header for homepage */
}

const { 
  title = "Susan Corbett Racing", 
  description = "Racehorse Training in Northumberland",
  image = "/susan-corbett-racing-logo-2",
  transparentHeader = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Mobile Header Colour -->
    <meta name="theme-color" content="#333f31"/>

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url.origin)} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/susan-corbett-racing-logo-1.svg" />
    <link rel="icon" href="/susan-corbett-racing-logo-1.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/susan-corbett-racing-logo-1.png" />
    
</head>

<body>
    
<a href="#main-content" class="skip-link">Skip to main content</a>

<header class={`header ${transparentHeader ? 'header-transparent' : ''}`}>
  <div class="header-inner">
  
    <!-- Hamburger Toggle Button -->
    <button 
      class="hamburger" 
      id="hamburger-btn" 
      aria-label="Toggle navigation menu" 
      aria-expanded="false" 
      aria-controls="nav-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav class="nav-links" id="nav-menu">
      <a href="/">Home</a>
      <a href="/news">News</a>
      <a href="/team">Our Team</a>
      <a href="/horses">Horses In Training</a>
      <a href="/facilities">Facilities</a>
      
      <!-- Dropdown Sub-Menu  -->
      <div class="dropdown">
        <button class="dropdown-toggle" aria-haspopup="true">Our Syndicates ▾</button>
        <div class="dropdown-menu">
          <a href="/syndicates/girsonfield">The Girsonfield Racing Syndicate</a>
          <a href="/syndicates/otterburn">The Otterburn Racing Syndicate</a>
          <a href="/syndicates/northern">The Northern Racing Syndicate</a>
          <a href="/syndicates/ladies-that-race">The Ladies That Race Syndicate</a>
          <a href="/syndicates/goodfellow">The Goodfeloow Racing Syndicate</a>
          <a href="/syndicates/nelson">The Nelson Racing Syndicate</a>
          <a href="/syndicates/race4fun">The Race4Fun Syndicate</a>
          <a href="/syndicates/tweed-valley">The Tweed Valley Racing Syndicate</a>
          <a href="/syndicates/naughty-but-nice">The Naughty But Nice And Ours For Life Syndicate</a>
          <a href="/syndicates/eclipse">The Eclipse Racing Club</a>

        </div>
      </div>

      <a href="/sales">Sales and Shares</a>
      <a href="/fees">Fees</a>
      <a href="/about">About Us</a>
    </nav>

    <script>
      const hamburgerBtn = document.getElementById('hamburger-btn');
      const navMenu = document.getElementById('nav-menu');

      if (hamburgerBtn && navMenu) {
        const toggleMenu = (open?: boolean) => {
          const state = open ?? !navMenu.classList.contains('is-active');
          navMenu.classList.toggle('is-active', state);
          hamburgerBtn.classList.toggle('is-active', state);
          hamburgerBtn.setAttribute('aria-expanded', state.toString());
        };

        hamburgerBtn.addEventListener('click', () => toggleMenu());

        // Close menu on Escape key press
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navMenu.classList.contains('is-active')) {
            toggleMenu(false);
            hamburgerBtn.focus();
          }
        });
      }

        // --- New Dropdown Logic ---
      const dropdown = document.querySelector('.dropdown');
      const dropdownBtn = document.querySelector('.dropdown-toggle') as HTMLButtonElement;

      if (dropdown && dropdownBtn) {
        // Toggle menu on button click
        dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation(); // Prevents click from bubbling up
        dropdown.classList.toggle('is-open');
        
        const isOpen = dropdown.classList.contains('is-open');
        dropdownBtn.setAttribute('aria-expanded', isOpen.toString());
        });

        // Close dropdown if user clicks anywhere outside of it
        document.addEventListener('click', (e) => {
        if (e.target instanceof Node && !dropdown.contains(e.target) && dropdown.classList.contains('is-open')) {
        dropdown.classList.remove('is-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
        }});
        
        // Close dropdown when pressing Escape key
        document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dropdown.classList.contains('is-open')) {
        dropdown.classList.remove('is-open');
        dropdownBtn.setAttribute('aria-expanded', 'false');
        dropdownBtn.focus();
        }});
      }

    </script>

  </div>

</header>

<main class="main" id="main-content">

  <slot />

</main>

<footer class="footer">
  <hr class="divider-full" />
  
  <p>Susan Corbett Racing</p>
  <p>&copy; {new Date().getFullYear()} Susan Corbett Racing. All rights reserved.</p>

  <nav class="footer-nav" aria-label="Legal navigation">
    <a href="/privacy">Privacy Policy</a>
    <a href="/cookies">Cookie Policy</a>
    <a href="/accessibility">Accessibility Statement</a>
  </nav>

  <WhatsAppButton phoneNumber="+447713651215" message="Hello. I have an enquiry about your yard." />

</footer>

</body>

</html>