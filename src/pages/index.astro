---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroImage from '../components/HeroImage.astro';

import bgImage from '../images/desktop-background.webp';
import bgImageMobile from '../images/mobile-background.webp';

import NavGrid from '../components/NavGridImage.astro';
import NewsGrid from '../components/NavGridImage.astro';

import newsImg1 from '../images/desktop-background.webp';
import newsImg2 from '../images/desktop-background.webp';
import newsImg3 from '../images/desktop-background.webp';

// Define the top 3 news items using the NavGrid structure
const newsItems = [
  {
    title: "WINNER - WEE ALKI",
    description: "Well done to the team today for another great win for Wee Alki! Ridden over 3 miles at Perth by Nathan Moscrop.",
    accent: "primary",
    image: newsImg1,
    imageAlt: "Wee Alki, staff and owners in the winning enclosure at Perth Racecourse."
  },
  {
    title: "OPEN DAY - NATIONAL RACEHORSE WEEK",
    description: "Join us at Girsonfield for our open day in support of National Racehorse Week. 22nd August 10.30 - 3.00 We have a program of events",
    accent: "secondary",
    image: newsImg2,
    imageAlt: "Open Day attendees watching a training demonstation."
  },
  {
    title: "WINNER - FREDDIE STEADY GO",
    description: "Far from the bookmaker's favourite - Freddie Steady Go upset the odds today with an incredible win at Carlisle. Well done Cam Hardie and the team.",
    accent: "primary",
    image: newsImg3,
    imageAlt: "Freddie Steady Go pictured racing at Carlisle Racecourse."
  }
];
---

<BaseLayout 
  title="Home | Susan Corbett Racing"
  description="Racehorse Training with Susan Corbett at Girsonfield, Northumberland"
  transparentHeader={true}
>

<HeroImage 
  title = "Susan Corbett Racing",
  lead = "Trainer of Flat and National Hunt Horses in the North East"
  description,
  bgImage = {bgImage}
  bgImageMobile = {bgImageMobile}
  primaryButtonText = "Check Sales and Shares Now",
  primaryButtonLink = /sales
  secondaryButtonText = "Text for secondary button",
  secondaryButtonLink,
  tintOpacity = "50%",
/>

<section class="prose-container">

  <header class="section-header">
    <h2>Welcome to Susan Corbett Racing</h2>
  </header>

  <div>
    <p>We are a family run racing yard in the North-East. We offer modern training for both National Hunt and Flat horses.</p>
    <p>We established our business Girsonfield Stud in Otterburn in 1999 with the ambition of creating an affordable thoroughbred stud farm for Northern breeders. From these origins Girsonfield has grown from a stud to a competitive racing yard - now Susan Corbett Racing.</p>
    <p>Our team is family orientated and professional and we give everything to fulfil the potential of every horse in our care. As part of this, we are committed to involving our clients in the yard through regular communication, yard visits, and get togethers.</p>
    <p>Don't hesitate to contact us if you want to join our growing group of owners, members, and supporters.</p>
  </div>

  <button class="btn btn-primary">Enquire</button>

</section>

<hr class="divider-full">

<NavGrid />

<hr class="divider-full">

<NewsGrid 
  title="Latest News",
  items={newsItems} 
/>

<!-- Centered 'See More' Button -->
<div class="prose-container" style="margin-top: -2rem;">
  <a href="/news" class="btn btn-secondary">See All News</a>
</div>

</BaseLayout>