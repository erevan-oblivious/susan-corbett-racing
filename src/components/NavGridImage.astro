---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import HorsesImg from '../images/desktop-background.webp';
import SalesImg from '../images/desktop-background.webp';
import TeamImg from '../images/desktop-background.webp';

interface CardItem {
  title: string;
  description: string;
  link?: string;
  linkText?: string;
  accent?: string;
  image?: ImageMetadata; /* Path to card image */
  imageAlt?: string; /* Optional alt text */
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: CardItem[];
}

const defaultItems: CardItem[] = [
  {
    title: "Horses in Training",
    description: "Flat and National Hunt",
    link: "/horses",
    linkText: "Get To Know Them",
    accent: "primary",
    image: HorsesImg,
    imageAlt: "A Horse Racing"
  },
  {
    title: "Sales and Shares",
    description: "Opportunities for Ownership",
    link: "/sales",
    linkText: "Take A Look",
    accent: "secondary",
    image: SalesImg,
    imageAlt: "A group of owners in the winning enclosure with their horse at a racecourse"
  },
  {
    title: "Our Team",
    description: "Working With Your Horses",
    link: "/team",
    linkText: "Get To Know US",
    accent: "primary",
    image: TeamImg,
    imageAlt: "A group photo of the team at Susan Corbett Racing"
  }
];

const {
  eyebrow,
  title = "Take a Look Around",
  subtitle,
  items = defaultItems
} = Astro.props;
---

<section class="nav-grid-section">
  <div class="nav-grid-container">

    {(eyebrow || title || subtitle) && (
      <header class="section-header">
        {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
        {title && <h2 class="section-title">{title}</h2>}
        {subtitle && <p class="section-subtitle">{subtitle}</p>}
      </header>
    )}

<div class="cards-grid">
      {items.map((item) => {
        // Automatically swap between an anchor link and a standard div container
        const CardElement = item.link ? 'a' : 'div';
        
        return (
          <CardElement 
            href={item.link} 
            class={`nav-card ${item.accent ? `accent-${item.accent}` : ''}`}
          >
            <!-- Decorative Accent Border -->
            <div class="card-border-top"></div>
            
            <!-- Card Image Header -->
            {item.image && (
              <div class="card-image-wrapper">
                <Image 
                  src={item.image} 
                  alt={item.imageAlt || item.title}
                  widths={[400, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  format="webp"
                />
              </div>
            )}
            
            <div class="card-content">
              <h3 class="card-title">{item.title}</h3>
              <p class="card-description">{item.description}</p>
              
              <!-- Only render the link text and arrow if a link is provided -->
              {item.link && (
                <div class="card-action">
                  <span class="action-text">{item.linkText || "Learn More"}</span>
                  <svg 
                    xmlns="http://www.w3.org/2000/svg" 
                    width="18" 
                    height="18" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    class="action-arrow"
                    aria-hidden="true"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              )}
            </div>
          </CardElement>
        );
      })}
    </div>

  </div>
</section>

<style>
  .nav-grid-section {
    padding: 5rem 1.5rem;
    background-color: var(--bg-primary);
  }

  .nav-grid-container {
    max-width: var(--max-width-wide, 71.25rem);
    margin: 0 auto;
  }

  /* Section Header */

  .section-title {
    font-family: var(--font-family-base);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--bg-secondary);
    line-height: 1.15;
    margin: 0 0 0.75rem 0;
  }

  .section-subtitle {
    font-size: 1.0625rem;
    color: var(--text-bright);
    line-height: 1.5;
    margin: 0;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }

  /* Card Container */
  .nav-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 8px);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease;
  }

  /* Top Border Accent Line */
  .card-border-top {
    height: 3px;
    width: 100%;
    background-color: transparent;
    transition: background-color 0.25s ease;
    z-index: 2;
  }

  .nav-card.accent-primary .card-border-top {
    background-color: var(--bg-secondary);
  }

  /* Image Container & Sizing */
  .card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Inner Content Padding */
  .card-content {
    padding: 1.5rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Typography */
  .card-title {
    font-family: var(--font-family-base);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-bright);
    line-height: 1.25;
    margin: 0 0 0.5rem 0;
    transition: color 0.2s ease;
  }

  .card-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-bright);
    margin: 0 0 1.5rem 0;
    flex-grow: 1;
  }

  /* Action Link & Animated Arrow */
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--bg-secondary);
    margin-top: auto;
  }

  .action-arrow {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  /* Hover States */
  .nav-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-subtle);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.15);
  }

  /* Subtle image zoom on hover */
  .nav-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .nav-card:hover .action-arrow {
    transform: translateX(5px);
  }

  @media (max-width: 640px) {
    .nav-grid-section {
      padding: 3.5rem 1rem;
    }
    
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>