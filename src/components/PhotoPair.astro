---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image1: ImageMetadata | string;
  alt1: string;
  caption1?: string;
  image2: ImageMetadata | string;
  alt2: string;
  caption2?: string;
  class?: string;
}

const {
  image1,
  alt1,
  caption1,
  image2,
  alt2,
  caption2,
  class: className,
} = Astro.props;
---

<div class:list={["photo-pair", className]}>
  <figure>
    {
      typeof image1 === 'string' ? (
        <img src={image1} alt={alt1} loading="lazy" />
      ) : (
        <Image src={image1} alt={alt1} />
      )
    }
    {caption1 && <figcaption>{caption1}</figcaption>}
  </figure>

  <figure>
    {
      typeof image2 === 'string' ? (
        <img src={image2} alt={alt2} loading="lazy" />
      ) : (
        <Image src={image2} alt={alt2} />
      )
    }
    {caption2 && <figcaption>{caption2}</figcaption>}
  </figure>
</div>

<style>
  /* Photo Pair Grid */
  .photo-pair {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two equal columns */
    gap: 1rem;                      /* Gap between images */
    width: 100%;
    margin-block: 1.5rem;
    margin-inline: auto;
  }

  .photo-pair figure {
    margin: 0;
    text-align: center;
  }

  /* Target both native img and Astro's optimized <Image /> output */
  .photo-pair img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;              /* Fills the half-slot without distorting */
    display: block;
    border-radius: var(--radius-md, 0.5rem);
  }

  .photo-pair figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted, #666);
  }

  /* Responsive collapse on mobile devices */
  @media (max-width: 640px) {
    .photo-pair {
      grid-template-columns: 1fr;
    }
  }
</style>