---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata | string;
  alt: string;
  mobileOrder?: number;
  desktopOrder?: number;
}

interface Props {
  items: GalleryItem[];
  columns?: number;
  aspectRatio?: string;
  class?: string;
}

const {
  items = [],
  columns = 3,
  aspectRatio = '2 / 3',
  class: className,
} = Astro.props;
---

<section class:list={['photo-gallery-container', className]}>
  <div class="photo-grid" style={`--grid-cols: ${columns};`}>
    {
      items.map((item, index) => {
        const mOrder = item.mobileOrder ?? index + 1;
        const dOrder = item.desktopOrder ?? index + 1;

        return (
          <div
            class="photo-card"
            style={`--m-order: ${mOrder}; --d-order: ${dOrder}; --aspect-ratio: ${aspectRatio};`}
          >
            {typeof item.src === 'string' ? (
              <img
                src={item.src}
                alt={item.alt}
                class="photo-img"
                loading="lazy"
              />
            ) : (
              <Image
                src={item.src}
                alt={item.alt}
                class="photo-img"
              />
            )}
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .photo-gallery-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .photo-card {
    position: relative;
    aspect-ratio: var(--aspect-ratio, 2 / 3);
    border-radius: var(--radius-lg, 1rem);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    order: var(--m-order);
  }

  @media (min-width: 768px) {
    .photo-grid {
      grid-template-columns: repeat(var(--grid-cols, 3), 1fr);
    }

    .photo-card {
      order: var(--d-order);
    }
  }

  .photo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
  }

  .photo-card:hover .photo-img {
    transform: scale(1.03);
  }
</style>